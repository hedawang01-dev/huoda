# Template only. npm scripts do not automatically load .env.
# Optional: node --env-file=.env scripts/build.cjs (Node.js 22).
# Browser-public values only; production build rejects empty/partial configuration.
HUODA_SUPABASE_URL=
HUODA_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key alternative, used only when PUBLISHABLE_KEY is empty.
HUODA_SUPABASE_ANON_KEY=
HUODA_CITY=广州
HUODA_DEFAULT_LAT=23.1291
HUODA_DEFAULT_LNG=113.2644

# Configure ONLY in the Supabase Edge Function environment; never a frontend secret.
ADMIN_ALLOWED_ORIGINS=

# Optional opt-in integration test, isolated disposable Supabase project ONLY.
# tests/live-concurrency.cjs WRITES applications and consumes a task seat.
# It is excluded from npm test and is NOT run by the default CI.
# Do not point these at production; never commit filled values.
TEST_URL=
TEST_ANON_KEY=
TEST_TASK_ID=
TEST_WORKER_EMAIL=
TEST_WORKER_PASSWORD=
TEST_SECOND_WORKER_EMAIL=
TEST_SECOND_WORKER_PASSWORD=
TEST_MERCHANT_EMAIL=
TEST_MERCHANT_PASSWORD=
