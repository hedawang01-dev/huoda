# Vercel production build. These two values are public browser connection values.
HUODA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
HUODA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
HUODA_CITY=广州
HUODA_DEFAULT_LAT=23.1291
HUODA_DEFAULT_LNG=113.2644

# Set ADMIN_ALLOWED_ORIGINS only in the Supabase Edge Function environment.
# Never put a Supabase secret key or service_role key in Vercel or config.js.
ADMIN_ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN
# Optional live integration test users, created in an isolated Supabase project.
TEST_WORKER_EMAIL=
TEST_WORKER_PASSWORD=
TEST_MERCHANT_EMAIL=
TEST_MERCHANT_PASSWORD=
